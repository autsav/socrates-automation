# Socrates Pipeline — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fal.ai — https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Meta Graph API
META_ACCESS_TOKEN=your_meta_long_lived_token_here
IG_ACCOUNT_ID=your_instagram_business_account_id_here

# Meta App credentials (for automatic token refresh)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Pixabay Music — https://pixabay.com/api/docs/
# Optional but recommended: downloads royalty-free music matching trending vibes
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Voiceover Narration (optional) ───────────────────────────────────────────
# OpenAI TTS — adds spoken narration to Reels (reads hook, quote, CTA aloud)
# Cost: ~$0.003 per 14s Reel. Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Notification Backends (all optional) ─────────────────────────────────────
# These send you a reminder after each post to manually add trending music.
# Telegram is recommended: instant mobile notification, free, easy setup.

# Telegram — talk to @BotFather to create a bot, @userinfobot to get your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Slack — create an Incoming Webhook in your Slack app settings
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Backend / Vercel (optional) ─────────────────────────────────────────────
# Supabase — required only if you deploy the receipt-upload API to Vercel
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=receipts
